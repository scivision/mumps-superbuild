@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})

set(MUMPS_UPSTREAM_VERSION @MUMPS_UPSTREAM_VERSION@)
set(MUMPS_ACTUAL_VERSION @MUMPS_ACTUAL_VERSION@)

set(MUMPS_intsize64 @MUMPS_intsize64@)
set(MUMPS_parallel @MUMPS_parallel@)

set(MUMPS_LAPACK_VENDOR @LAPACK_VENDOR@)

set(MUMPS_SCALAPACK_VENDOR @SCALAPACK_VENDOR@)
set(MUMPS_scalapack @MUMPS_scalapack@)

set(MUMPS_s_FOUND @BUILD_SINGLE@)
set(MUMPS_SINGLE @BUILD_SINGLE@)

set(MUMPS_d_FOUND @BUILD_DOUBLE@)
set(MUMPS_DOUBLE @BUILD_DOUBLE@)

set(MUMPS_c_FOUND @BUILD_COMPLEX@)
set(MUMPS_COMPLEX @BUILD_COMPLEX@)

set(MUMPS_z_FOUND @BUILD_COMPLEX16@)
set(MUMPS_COMPLEX16 @BUILD_COMPLEX16@)

if(MUMPS_parallel)
  find_dependency(MPI COMPONENTS C Fortran)

  if(NOT MUMPS_LAPACK_VENDOR MATCHES "^MKL")
    find_dependency(LAPACK COMPONENTS ${MUMPS_LAPACK_VENDOR})
  endif()

  if(DEFINED MUMPS_SCALAPACK_VENDOR)
    find_dependency(SCALAPACK COMPONENTS ${MUMPS_SCALAPACK_VENDOR})
  elseif(MUMPS_scalapack)
    find_dependency(SCALAPACK)
  else()
    find_dependency(SCALAPACK CONFIG)
  endif()
else()
  find_dependency(LAPACK COMPONENTS ${MUMPS_LAPACK_VENDOR})

  # This is used in place of find_dependency(MPI) in MUMPS when MUMPS_parallel is OFF
  # may not have ALIAS of ALIAS so we do INTERFACE IMPORTED of ALIAS
  add_library(MPI::MPI_C INTERFACE IMPORTED)
  target_link_libraries(MPI::MPI_C INTERFACE MUMPS::mpiseq_c)

  add_library(MPI::MPI_Fortran INTERFACE IMPORTED)
  target_link_libraries(MPI::MPI_Fortran INTERFACE MUMPS::mpiseq_fortran)
endif()

set(MUMPS_scotch @MUMPS_scotch@)
set(MUMPS_find_scotch @MUMPS_find_scotch@)
set(SCOTCH_COMPONENTS @SCOTCH_COMPONENTS@)
if(MUMPS_scotch)
  find_dependency(SCOTCH COMPONENTS ${SCOTCH_COMPONENTS})
endif()

set(MUMPS_metis @MUMPS_metis@)
if(MUMPS_metis)
  find_dependency(METIS)
endif()

set(MUMPS_gpu @MUMPS_gpu@)
if(MUMPS_gpu)
  find_dependency(CUDAToolkit)
endif()

set(MUMPS_xkblas @MUMPS_xkblas@)

set(MUMPS_HAVE_GEMMT @BLAS_HAVE_GEMMT@)

set(MUMPS_HAVE_AVX512VBMI @MUMPS_HAVE_AVX512VBMI@)

set(MUMPS_parmetis @MUMPS_parmetis@)
if(MUMPS_parmetis)
  find_dependency(METIS COMPONENTS ParMETIS)
endif()

set(MUMPS_openmp @MUMPS_openmp@)
set(MUMPS_shared @BUILD_SHARED_LIBS@)
if(MUMPS_openmp)
  # Nothing in MUMPS-targets.cmake references OpenMP::*, and a shared MUMPS already records its
  # own OpenMP runtime, so consumers do not need OpenMP to link it. Requiring it unconditionally
  # locks out consumers that enable only C (the Fortran component can never be satisfied) and
  # consumers whose C compiler has no OpenMP, e.g. AppleClang without libomp.
  # A static MUMPS does need the flags on the consumer's link line, so keep it required there.
  get_property(_mumps_langs GLOBAL PROPERTY ENABLED_LANGUAGES)
  set(_mumps_omp_components)
  foreach(_mumps_lang IN ITEMS C Fortran)
    if(_mumps_lang IN_LIST _mumps_langs)
      list(APPEND _mumps_omp_components ${_mumps_lang})
    endif()
  endforeach()

  if(_mumps_omp_components)
    if(MUMPS_shared)
      find_package(OpenMP COMPONENTS ${_mumps_omp_components})
    else()
      find_dependency(OpenMP COMPONENTS ${_mumps_omp_components})
    endif()
  endif()

  unset(_mumps_langs)
  unset(_mumps_lang)
  unset(_mumps_omp_components)
endif()

# all dependencies must be determined before this project's targets
include(${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-targets.cmake)

check_required_components(@PROJECT_NAME@)
